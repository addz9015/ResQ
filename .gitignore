# ── secrets ─────────────────────────────────────────────────────────────────
.env
.env.local
*.key

# ── python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# ── node ────────────────────────────────────────────────────────────────────
node_modules/

# ── OS cruft ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── downloaded / derived caches (rebuilt by scripts on demand) ───────────────
data/era5_cache/
data/gadm_cache/
data/ndma_cache/
data/imd_bulletins/_raw/

# ── regenerable build artifacts ─────────────────────────────────────────────
# parquet grids: rebuilt by `python app/run.py --rebuild`
data/*.parquet
# dashboard payloads: rebuilt by `python app/run.py --rebuild`
app/static/data/*.json
app/static/data/*.pkl
# report figures copied into the app: rebuilt by scripts/build_insights.py
app/static/img/*.png

# ── runtime logs (regenerated on each build/run) ────────────────────────────
reports/guard_discards.jsonl
data/ndma_guidance/STATUS.md

# ── kept on purpose (do NOT ignore) ─────────────────────────────────────────
# reports/_fragments/*  — research-pipeline outputs the report/insight builders
#   read; NOT regenerated by app/run.py (needs the full run_models.py pipeline).
# data/ndma_guidance.json, data/checklist_rules.json — checked in so the
#   Checklist tab works without a network fetch.
